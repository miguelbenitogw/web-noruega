# Las únicas variables que el código lee de verdad.
# Comprobado con: rg "import.meta.env.VITE_[A-Z_]+" src index.html
#
# Ojo con el prefijo VITE_: todo lo que lo lleve acaba EN EL BUNDLE que se
# descarga el visitante. No es un sitio donde esconder nada. Aquí no hay
# secretos: las claves de EmailJS son públicas por diseño y el ID de Analytics
# también. Si algún día hace falta un secreto de verdad, no puede vivir aquí.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
